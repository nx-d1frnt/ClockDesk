<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingEnd="12dp"
    android:paddingStart="4dp"
    android:paddingVertical="4dp">

    <FrameLayout
        android:id="@+id/media_card_container"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_clock_style_unselected"
        android:padding="6dp">

        <!-- 1. Minimal Ticker Preview -->
        <LinearLayout
            android:id="@+id/minimal_ticker_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:id="@+id/minimal_preview_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/music_note"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/minimal_preview_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="?attr/colorOnSurface"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Song" />
        </LinearLayout>

        <!-- 2. Compact Card Preview -->
        <LinearLayout
            android:id="@+id/compact_card_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="2dp"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:src="@drawable/music_note"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/compact_preview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="Track" />

                <TextView
                    android:id="@+id/compact_preview_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:textSize="8sp"
                    tools:text="Artist" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Expanded Player Preview -->
        <LinearLayout
            android:id="@+id/expanded_player_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:src="@drawable/music_note"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/expanded_preview_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        tools:text="Track" />

                    <TextView
                        android:id="@+id/expanded_preview_artist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="?attr/colorOnSurface"
                        android:alpha="0.7"
                        android:textSize="7sp"
                        tools:text="Artist" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mini control buttons row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="6dp"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="?attr/colorOnSurface" />

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_skip_next"
                    app:tint="?attr/colorOnSurface" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    <!-- Selection indicator divider line -->
    <View
        android:id="@+id/selection_divider"
        android:layout_width="3dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:background="?attr/colorOnSurface"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
