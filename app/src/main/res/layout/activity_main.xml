<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/edit_mode_blur_layer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:alpha="0"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/background_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/gradient_background"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <FrameLayout
                android:id="@+id/background_frame"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/background_image_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/thumbnail_desc"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <com.nxd1frnt.clockdesk2.ui.view.DynamicBackgroundView
                    android:id="@+id/dynamic_background_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.nxd1frnt.clockdesk2.ui.view.TurbulenceView
                    android:id="@+id/turbulence_overlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="10dp" />

                <com.nxd1frnt.clockdesk2.ui.view.PerformanceOverlayView
                    android:id="@+id/performance_overlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <!-- Progress overlay shown while blur is being applied -->

            </FrameLayout>

        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/desks_view_pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.nxd1frnt.clockdesk2.desks.ui.DeskPageIndicatorView
            android:id="@+id/desk_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Edit Mode Bottom Action Bar / Dock -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/edit_mode_action_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="36dp"
            app:cardElevation="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <!-- System Controls Group -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_button"
                    android:singleLine="true"
                    app:icon="@drawable/ic_cog" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/demo_button"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/demo_button"
                    android:singleLine="true"
                    app:icon="@drawable/ic_timelapse" />

                <!-- Visual Divider: System vs Layout -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="8dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Layout Controls Group -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_widget"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_widget"
                    android:singleLine="true"
                    app:icon="@drawable/ic_add" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_layout"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reset_layout"
                    android:singleLine="true"
                    app:icon="@drawable/ic_backup_restore" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_manage_desks"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/manage_desks_btn"
                    android:singleLine="true"
                    app:icon="@drawable/ic_grid" />

                <!-- Visual Divider: Layout vs Exit -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="8dp"
                    android:background="?attr/colorOutlineVariant" />

                <!-- Confirmation Action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done_edit"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="@string/done"
                    app:icon="@drawable/ic_check" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/side_sheet_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/side_sheet"
            style="@style/Widget.Material3.SideSheet"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:elevation="16dp"
            app:behavior_draggable="true"
            app:layout_behavior="com.google.android.material.sidesheet.SideSheetBehavior">
            <include layout="@layout/side_sheet_customization" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_gallery_side_sheet"
            style="@style/Widget.Material3.SideSheet"
            android:layout_width="380dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:elevation="16dp"
            app:behavior_draggable="true"
            app:layout_behavior="com.google.android.material.sidesheet.SideSheetBehavior">
            <include layout="@layout/side_sheet_add_widget" />
        </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <include layout="@layout/tutorial_layout" />
    <!-- Backgrounds bottom sheet (separate) -->
    <FrameLayout
        android:id="@+id/background_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include layout="@layout/sheet_backgrounds" />

    </FrameLayout>
    <include
        layout="@layout/overlay_crop_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
        <FrameLayout
            android:id="@+id/desk_notification_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <FrameLayout
            android:id="@+id/desk_call_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="28dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/smart_pixel_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:alpha="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:visibility="visible" />

        <include layout="@layout/overlay_desk_overview" />
    </androidx.constraintlayout.widget.ConstraintLayout>