<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/native_view_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp" />

        <!-- Edit Overlay -->
        <LinearLayout
            android:id="@+id/edit_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:orientation="horizontal"
            android:background="#D0000000"
            android:layout_margin="8dp"
            android:padding="2dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btn_tile_edit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/pencil_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FFFFFF"
                android:contentDescription="Edit tile" />

            <ImageButton
                android:id="@+id/btn_tile_delete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#FF5252"
                android:contentDescription="Delete tile" />
        </LinearLayout>

    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
