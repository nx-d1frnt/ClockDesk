<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="?attr/colorSurfaceContainer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dashboard_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good morning"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/dashboard_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to your workspace"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dashboard_restore_defaults"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                app:icon="@drawable/ic_backup_restore"
                app:iconTint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Restore Defaults" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dashboard_import_widget"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                app:icon="@drawable/ic_zip_import"
                app:iconTint="?attr/colorPrimary"
                android:contentDescription="Import ZIP Widget" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dashboard_add_widget"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:visibility="gone"
                app:icon="@android:drawable/ic_menu_add"
                app:iconTint="?attr/colorPrimary"
                android:contentDescription="Add Widget" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_dashboard_toggle_edit"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/pencil_outline"
                app:iconTint="?attr/colorPrimary"
                android:contentDescription="Toggle Edit Mode" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />

    <!-- Scenario Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scenario_lights_off"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="All Off"
            app:icon="@drawable/ic_dim"
            app:iconGravity="textStart"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scenario_media_stop"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Stop Music"
            app:icon="@drawable/music_note"
            app:iconGravity="textStart"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
