<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingEnd="12dp"
    android:paddingStart="4dp"
    android:paddingVertical="4dp">

    <FrameLayout
        android:id="@+id/date_card_container"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/bg_clock_style_unselected"
        android:padding="8dp">

        <!-- 2-Line stacked preview container -->
        <LinearLayout
            android:id="@+id/two_line_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical|start"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/preview_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:gravity="start"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Mon" />

            <TextView
                android:id="@+id/preview_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:gravity="start"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Oct 4" />
        </LinearLayout>

        <!-- Single line date preview -->
        <TextView
            android:id="@+id/single_line_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            android:singleLine="true"
            android:textStyle="bold"
            tools:text="Mon, Oct 4" />

        <!-- Calendar badge preview -->
        <com.nxd1frnt.clockdesk2.ui.view.DateTextView
            android:id="@+id/badge_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Hero day preview container -->
        <LinearLayout
            android:id="@+id/hero_day_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/hero_day_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="?attr/colorOnSurface"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="04" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="4dp"
                android:gravity="start">

                <TextView
                    android:id="@+id/hero_day_weekday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    tools:text="MON" />

                <TextView
                    android:id="@+id/hero_day_month"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="?attr/colorOnSurface"
                    android:alpha="0.7"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="OCT" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chip pill preview container -->
        <TextView
            android:id="@+id/chip_pill_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_material_badge"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="5dp"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Mon, Oct 4" />
    </FrameLayout>

    <!-- Selection indicator divider line -->
    <View
        android:id="@+id/selection_divider"
        android:layout_width="3dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:background="?attr/colorOnSurface"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
