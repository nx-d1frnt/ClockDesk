<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/media_artwork_card"
    android:layout_width="320dp"
    android:layout_height="152dp"
    android:visibility="gone"
    app:cardBackgroundColor="#17251F"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/artwork_cover_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/artwork_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_media_artwork_scrim" />

        <ImageView
            android:id="@+id/artwork_source_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/music_note"
            app:tint="#A2F5C3" />

        <TextView
            android:id="@+id/artwork_source_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="26dp"
            android:paddingVertical="4dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_media_source_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:maxWidth="180dp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:textColor="#D5FFE5"
            android:textSize="11sp"
            tools:text="Music" />

        <LinearLayout
            android:id="@+id/artwork_track_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="94dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/artwork_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                tools:text="desolate" />

            <TextView
                android:id="@+id/artwork_artist_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp"
                tools:text="vämpp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_artwork_play_pause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_media_play_button"
            android:clickable="true"
            android:contentDescription="@string/action_play_pause"
            android:focusable="true"
            android:padding="16dp"
            android:src="@drawable/ic_play_arrow"
            app:tint="#00391E" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_artwork_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/action_previous"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="#FFFFFF" />

            <com.nxd1frnt.clockdesk2.ui.view.SquigglyProgressBar
                android:id="@+id/artwork_progress_bar"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btn_artwork_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/action_next"
                android:focusable="true"
                android:padding="14dp"
                android:src="@drawable/ic_skip_next"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
