<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="96dp"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        app:cardCornerRadius="20dp"
        android:clipChildren="true">

    <ImageView
        android:id="@+id/background_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="@drawable/item_font_card"
        android:contentDescription="@string/thumbnail_desc" />

    <View
        android:id="@+id/selection_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#BB37618E"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btn_settings"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:padding="5dp"
        android:background="@drawable/circle_call_bg"
        android:src="@drawable/ic_cog"
        android:contentDescription="@string/settings_title"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/plugin_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="6dp"
        android:padding="4dp"
        android:background="@drawable/circle_call_bg"
        android:contentDescription="@string/external_plugin_desc"
        android:visibility="gone" />
    </androidx.cardview.widget.CardView>
</FrameLayout>
