<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tutorial_overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#70000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/onboarding_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <!-- Main Slide Content Container (Clean side-by-side split layout) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/onboarding_content_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingHorizontal="32dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            app:layout_constraintWidth_max="880dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/onboarding_bottom_bar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Left Column: Clean Icon + Dot Indicators -->
            <LinearLayout
                android:id="@+id/onboarding_left_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintWidth_percent="0.28"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/onboarding_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:id="@+id/onboarding_indicator_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Right Column: Title, Description & Action Button -->
            <LinearLayout
                android:id="@+id/onboarding_right_column"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="24dp"
                app:layout_constraintStart_toEndOf="@id/onboarding_left_column"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/onboarding_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome to ClockDesk"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/googlesansflex" />

                <TextView
                    android:id="@+id/onboarding_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Transform your idle phone or tablet into a beautiful bedside or desk companion."
                    android:textColor="#D0FFFFFF"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.2"
                    android:fontFamily="@font/googlesansflex" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/onboarding_btn_action"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="8dp"
                    android:text="Grant Location"
                    android:textColor="#121212"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="100dp"
                    app:icon="@drawable/ic_sun_clock_outline"
                    app:iconTint="#121212"
                    android:fontFamily="@font/googlesansflex" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom Navigation Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/onboarding_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingVertical="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_btn_left"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Skip"
                android:textColor="#D0FFFFFF"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/onboarding_btn_right"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="28dp"
                android:paddingVertical="10dp"
                android:text="Next"
                android:textColor="#121212"
                android:textSize="15sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="100dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Kept here for compatibility with existing variable lookups in MainActivity -->
    <ImageView
        android:id="@+id/tutorial_finger_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/cursor_pointer"
        android:rotation="-10"
        android:alpha="0.0"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/tutorial_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="80dp"
        android:alpha="0.0"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:fontFamily="@font/googlesansflex"
        android:shadowColor="#80000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>